# MeeChat local env template
# Copy to `.env` and fill real values. Never commit `.env`.

# ── Required: Postgres (local Docker) + Better Auth ──
DATABASE_URL=postgresql://meechat:meechat@localhost:5432/meechat
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Required: AI chat (OpenAI-compatible) ──
# Base URL เท่านั้น (โค้ดต่อ /chat/completions ให้) เช่น:
# LLM_API_URL=https://api.tokenme.limited/api/v1
# ถ้าไม่ใส่ ใช้ https://openrouter.ai/api/v1
LLM_API_URL=
# Model id ที่ส่งเข้า API ทั้งระบบ (บังคับ; user เลือกไม่ได้) เช่น gpt-4o-mini
LLM_MODEL=
LLM_API_KEY=

# ── Payments ──
# off (default): leave PAYMENTS_ENABLED unset/false
# mock (dev/E2E): credit immediately, no Stripe
# stripe (prod/test): set STRIPE_* and remove PAYMENTS_MODE=mock
PAYMENTS_ENABLED=true
PAYMENTS_MODE=mock
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Optional: rate limit (skip when unset) ──
# UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ── Optional: protect cron routes (Bearer token) ──
# CRON_SECRET=

# ── Optional: app tuning ──
# Creator submit auto-publishes when not "false" (MVP default)
CREATOR_AUTO_APPROVE=true
# Prisma pg.Pool max connections (default 4)
DATABASE_POOL_MAX=4

# ── Optional: tests ──
# TEST_BASE_URL=http://localhost:3000
